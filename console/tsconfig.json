{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src"],
  // Tests are not shipped, and they need node and the vitest globals. Keeping
  // them out here means app code still cannot import either by accident;
  // tsconfig.test.json checks them under the same strictness.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}
