# ---------------------------------------------------------------------------
# Chronos — environment template.  Copy to .env and fill in.
#   cp .env.example .env
# NEVER commit .env.
#
# The stack runs with NONE of these set: mockllm serves answers and the
# recorded fixtures serve evidence. Each key below switches on a real path.
# ---------------------------------------------------------------------------

# ===========================================================================
# MODELS — free and open-weights by default
# ===========================================================================
#
# Chronos needs a model for two jobs: pulling claims out of an answer, and
# judging evidence. Both need reliable instruction-following and JSON.
#
# The default is Groq, because it is the only provider that still gives a
# genuinely free allowance with no credit card, and it serves open-weights
# models (Llama, and OpenAI's open gpt-oss) fast enough that verification
# stays inside its deadline.
#
#   Get a key, no card:  https://console.groq.com/keys
#   Current model ids:   https://console.groq.com/docs/models
#   Your real limits:    https://console.groq.com/settings/limits
#
# IMPORTANT: model ids change. These were read from Groq's live model list,
# and the Llama chat models most guides still recommend now return 404:
#
#   openai/gpt-oss-120b     Apache-2.0 weights, 131k context   <- default
#   openai/gpt-oss-20b      same family, cheaper per call      <- fallback
#   qwen/qwen3.8-27b        Alibaba, open weights, 131k        <- fallback
#
# List what your key can actually reach:
#   ./scripts/check-model.sh --all
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
#
# Limits are per organisation, not per key, so extra keys do not add headroom.
GROQ_API_KEY=gsk_replace-me

# Which model does which job. NOTE: Groq meters tokens-per-minute PER MODEL,
# so extraction and judging deliberately use different models — each gets
# its own budget instead of competing for one. Chronos makes one extraction
# call per answer and one judge call per claim-cache MISS, so the judge gets
# the cheaper model and the 1,000/day allowance goes a long way once the
# claim cache is warm.
CHRONOS_EXTRACT_MODEL=groq/openai/gpt-oss-120b
CHRONOS_JUDGE_MODEL=groq/openai/gpt-oss-20b

# Bifrost tries these in order when the primary fails — including on a 429, so
# a spent 70B allowance degrades to the 8B model rather than to rule-based
# judging. Comma-separated "provider/model".
CHRONOS_FALLBACK_MODELS=groq/openai/gpt-oss-20b,groq/qwen/qwen3.8-27b,ollama/llama3.1

# Leave empty to follow CHRONOS_OFFLINE_DEMO. Set to 1 to force model-based
# extraction and judging, or 0 to force the rule engine (useful for measuring
# the difference the model makes).
CHRONOS_LIVE_MODELS=

# --- Fully local alternative: no key, no quota, no network ---
#   docker compose --profile local up -d ollama
#   docker compose exec ollama ollama pull llama3.1
#   CHRONOS_EXTRACT_MODEL=ollama/llama3.1
OLLAMA_BASE_URL=http://ollama:11434

# --- Paid, optional. Only used if you set it. ---
OPENAI_API_KEY=

# ===========================================================================
# LIVE EVIDENCE
# ===========================================================================
# Without this, evidence comes from verifier/fixtures/evidence.json and the
# verdicts reflect recorded pages rather than the live web.
#   Free key: https://app.tavily.com
TAVILY_API_KEY=tvly-replace-me

# Stop buying evidence after this many credits in a day. When spent, Chronos
# degrades to observe mode and says so, rather than overspending silently.
CHRONOS_TAVILY_DAILY_CREDITS=400

# ===========================================================================
# GATEWAY
# ===========================================================================
# Virtual key the verifier authenticates with. Must start with sk-bf- or
# Bifrost mints its own and ignores this one.
CHRONOS_VK=sk-bf-chronos-verifier-dev

# Any 32-byte string; encrypts the config store at rest.
BIFROST_ENCRYPTION_KEY=chronos-dev-encryption-key-32byte

# Bifrost requires this on every /api call while dashboard auth is inactive.
# Chronos uses it to authenticate cache eviction (DELETE /api/cache/clear/...).
BIFROST_SETUP_TOKEN=chronos-dev-setup-token

# ===========================================================================
# CHRONOS BEHAVIOUR
# ===========================================================================
# observe  : verify out of band, never touch the response
# annotate : observe + x-chronos-* response headers, and evict stale entries
# guard    : verify inline; below the threshold, regenerate once or block
CHRONOS_MODE=annotate
CHRONOS_GUARD_THRESHOLD=50
CHRONOS_VERIFY_TIMEOUT_MS=4000
CHRONOS_DEBUG=0

# When 1, nothing leaves the machine: answers come from mockllm and evidence
# from the recorded fixtures. This is what makes `docker compose up` and CI
# work with no credentials at all.
CHRONOS_OFFLINE_DEMO=1

# ===========================================================================
# BUILD AND LOGGING
# ===========================================================================
# The Bifrost tag the image is built from. Changing it rebuilds the gateway
# from a different source tree, and the plugin is compiled against it.
BIFROST_REF=transports/v2.4.0
BIFROST_LOG_LEVEL=info

# Reported by the verifier's /health.
CHRONOS_VERSION=0.1.0

# Make the keyless mock provider feel like a real one, in milliseconds.
MOCKLLM_LATENCY_MS=0
