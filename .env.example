# ---------------------------------------------------------------------------
# Chronos — environment template.  Copy to .env and fill in.
#   cp .env.example .env
# NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Model providers (used by Bifrost for both user traffic and Chronos's
#     own extraction/judge calls, which are routed back through Bifrost) ---
OPENAI_API_KEY=sk-replace-me
GROQ_API_KEY=gsk_replace-me

# --- Live evidence ---
TAVILY_API_KEY=tvly-replace-me

# --- Bifrost virtual key that the verifier authenticates with.
#     Must match governance.virtual_keys[].value in deploy/bifrost.config.json.
CHRONOS_VK=sk-bf-chronos-verifier-dev

# --- Bifrost config-store encryption key (any 32-byte string) ---
BIFROST_ENCRYPTION_KEY=chronos-dev-encryption-key-32byte

# --- Chronos behaviour ---
# observe  : verify asynchronously, never touch the response
# annotate : observe + response headers (default)
# guard    : verify synchronously, regenerate/block below threshold
CHRONOS_MODE=annotate
CHRONOS_GUARD_THRESHOLD=50
CHRONOS_VERIFY_TIMEOUT_MS=4000

# Tavily credit budget per day; when spent, Chronos degrades to observe mode.
CHRONOS_TAVILY_DAILY_CREDITS=400

# --- Keyless demo ---
# When 1, deploy/mockllm serves deterministic, intentionally-stale answers so
# the whole stack runs (and CI passes) with no provider or Tavily keys at all.
CHRONOS_OFFLINE_DEMO=1
